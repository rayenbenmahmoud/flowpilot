# FlowPilot configuration. Copy to .env and fill in. This file contains placeholders only.
# Never commit .env. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Mode -------------------------------------------------------------------
# true  = emails, n8n and partner APIs are SIMULATED. No account or paid service needed.
# false = real integrations are used when configured below.
FLOWPILOT_DEMO_MODE=true

# ---- Django -----------------------------------------------------------------
# DJANGO_DEBUG=true allows a built-in insecure dev key. Set false and a real key for anything shared.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true when serving over HTTPS:
DJANGO_SECURE_COOKIES=false

# ---- Webhook ----------------------------------------------------------------
# Shared secret used to sign inbound webhooks (HMAC-SHA256). Webhooks are refused while this is empty.
FLOWPILOT_WEBHOOK_SECRET=
FLOWPILOT_WEBHOOK_RATE=60/min

# ---- Demo login (only used by `seed_demo`, only in demo mode) ----------------------
FLOWPILOT_DEMO_USER_PASSWORD=flowpilot-demo

# ---- Database / queue ---------------------------------------------------------
# Leave DATABASE_URL empty for a zero-setup local SQLite file. Docker Compose overrides these.
DATABASE_URL=
# Leave empty to run background jobs inline (no Redis needed).
CELERY_BROKER_URL=
REDIS_URL=
POSTGRES_DB=flowpilot
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=change-me-before-sharing

# ---- Reliability limits -------------------------------------------------------
FLOWPILOT_MAX_ATTEMPTS=3
FLOWPILOT_ADAPTER_TIMEOUT=5
FLOWPILOT_ADAPTER_MAX_ATTEMPTS=2

# ---- Live integrations (ignored while FLOWPILOT_DEMO_MODE=true) ----------------------
# n8n: base URL of your instance and the shared secret your n8n Webhook node checks (Header Auth).
FLOWPILOT_N8N_BASE_URL=
FLOWPILOT_N8N_WEBHOOK_SECRET=
# Generic partner REST API
FLOWPILOT_EXTERNAL_API_BASE_URL=
FLOWPILOT_EXTERNAL_API_KEY=
# SMTP email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=FlowPilot <no-reply@example.com>
